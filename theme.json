					"outline": {
						"border": {
							"color": "currentColor",
							"radius": "0px",
							"width": "1px"
						},
						"spacing": {
							"padding": {
								"bottom": "calc(1rem - 0.5px)",
								"left": "calc(2.25rem - 0.5px)",
								"right": "calc(2.25rem - 0.5px)",
								"top": "calc(1rem - 0.5px)"
							}
						}
					}
				}
			},
			"core/buttons": {
				"spacing": {
					"blockGap": "16px"
				}
			},
			"core/code": {
